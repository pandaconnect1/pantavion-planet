# Pantavion private production water network bridge
# Do NOT put raw KMZ/KML in GitHub or public folders.
# This URL must point to a private/protected processed GeoJSON file in cloud/object storage.
PANTAVION_WATER_NETWORK_GEOJSON_URL=

# Optional bearer token if the private cloud source requires one.
PANTAVION_WATER_NETWORK_GEOJSON_BEARER_TOKEN=

# Pantavion Water Engineering AI worker
# Prefer a private Railway service URL (for example, http://<service>.railway.internal)
# or an HTTPS endpoint. Never expose the worker bearer token to browser/client code.
PANTAVION_WATER_ENGINEERING_WORKER_URL=
PANTAVION_WATER_ENGINEERING_WORKER_TOKEN=
